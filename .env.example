# Stripe live/test API credentials used by the webhook server.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_DEFAULT_TAX_RATE_ID=txr_your_21_percent_vat_rate_here
CREATE_SUBSCRIPTIONS=false

# EventsAir GraphQL / Azure AD credentials used to look up registrations by email.
EVENTSAIR_TENANT_ID=
EVENTSAIR_CLIENT_ID=
EVENTSAIR_CLIENT_SECRET=
EVENTSAIR_GRAPHQL_URL=https://api.eventsair.com/graphql
EVENTSAIR_TOKEN_SCOPE=https://eventsairprod.onmicrosoft.com/85d8f626-4e3d-4357-89c6-327d4e6d3d93/.default
EVENTSAIR_CONTACT_LOOKUP_EVENT_ID=

# Optional local file paths for webhook event dedupe state and JSON-line logging.
WEBHOOK_EVENT_STATE_PATH=
WEBHOOK_LOG_PATH=
WEBHOOK_CONSOLE_LOGS=true

PORT=3000
